# ====================================================================
# Smita Motgi Tool - Environment Variables Template
# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local (it is git-ignored).
# ====================================================================

# --- Premium lip-sync / talking-head (optional, paid) ---
# Powers the "🎤 Premium lip-sync" toggle: photoreal mouth movement of an
# uploaded photo. Requires a Replicate account with billing enabled.
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional: talking-head model + pinned version (defaults to cjwbw/sadtalker latest)
REPLICATE_TALKINGHEAD_MODEL=cjwbw/sadtalker
REPLICATE_TALKINGHEAD_VERSION=

# RunwayML (https://dev.runwayml.com)
RUNWAYML_API_KEY=

# Stability AI (https://platform.stability.ai/account/keys)
STABILITY_API_KEY=

# --- Story understanding / script generation (Anthropic Claude) ---
# Required for the "Analyze Story with AI" feature.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the Claude model (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# --- AI expression/outfit image generation (Google Gemini image model) ---
# Required for the "✨ AI expressions" button (auto-creates expression/outfit
# variations of an uploaded character). Costs a few cents per image.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the image model (defaults to gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- App config ---
# Public base URL of the deployed app (used for absolute links/webhooks)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
