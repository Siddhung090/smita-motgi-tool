# ====================================================================
# Smita Motgi Tool - Environment Variables Template
# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local (it is git-ignored).
# ====================================================================

# --- Video generation provider (pick the one you use) ---
# Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# RunwayML (https://dev.runwayml.com)
RUNWAYML_API_KEY=

# Stability AI (https://platform.stability.ai/account/keys)
STABILITY_API_KEY=

# --- Story understanding / script generation (Anthropic Claude) ---
# Required for the "Analyze Story with AI" feature.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the Claude model (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# --- App config ---
# Public base URL of the deployed app (used for absolute links/webhooks)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
